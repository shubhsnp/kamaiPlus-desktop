{
  "name": "kamai-plus-desktop",
  "version": "4.138.0",
  "private": true,
  "description": "KamaiPlus Desktop Application",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "npx tsx scripts/e2e_simulation.ts",
    "test:electron": "node scripts/electron_e2e.mjs",
    "version:bump": "npx tsx scripts/bump_version.ts",
    "electron": "electron . --dev",
    "electron:prod": "electron .",
    "build:desktop": "next build && electron-builder --win",
    "electron:dev": "electron . --dev",
    "release:desktop": "next build && electron-builder --win && node scripts/prepare_release.js",
    "release:publish": "firebase deploy --only hosting:updates",
    "release:beta": "next build && electron-builder --win && node scripts/prepare_release.js --beta",
    "release:promote": "node scripts/prepare_release.js --promote",
    "test:cloud": "node scripts/run_cloud_test.mjs",
    "test:smoke": "node scripts/smoke_pages.mjs",
    "release:github": "node scripts/publish_github_release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react-virtuoso": "^4.18.14",
    "use-debounce": "^10.1.1",
    "v8-compile-cache": "^2.4.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "firebase": "^12.18.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "next": "^16.3.1",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "protobufjs@7.6.5": true
  },
  "main": "main.js",
  "build": {
    "appId": "com.kamaiplus.desktop",
    "productName": "KamaiPlus Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "licence.js",
      "updater.js",
      "backup.js",
      "errorlog.js",
      "printers.js",
      "psWorker.js",
      "adminLink.js",
      "whatsapp.js",
      "labelCalibrate.js",
      "googleSignIn.js",
      "preload.js",
      "out/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KamaiPlus Desktop",
      "artifactName": "KamaiPlus-Desktop-Setup-${version}.${ext}",
      "differentialPackage": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://kamaiplus-desktop.web.app/"
      }
    ]
  }
}
