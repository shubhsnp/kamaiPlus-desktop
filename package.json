{
  "name": "kamai-plus-desktop",
  "version": "4.28.0",
  "private": true,
  "description": "KamaiPlus Desktop Application",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "npx tsx scripts/e2e_simulation.ts",
    "version:bump": "npx tsx scripts/bump_version.ts",
    "deploy:firebase": "next build && firebase deploy --only hosting",
    "electron": "electron . --dev",
    "electron:prod": "electron .",
    "build:desktop": "next build && electron-builder --win",
    "electron:dev": "electron . --dev"
  },
  "dependencies": {},
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.19",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "next": "^16.3.1",
    "nodemailer": "^10.0.10",
    "postcss": "^8.5.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "protobufjs@7.6.5": true
  },
  "main": "main.js",
  "build": {
    "appId": "com.kamaiplus.desktop",
    "productName": "Retail POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Retail POS"
    }
  }
}
