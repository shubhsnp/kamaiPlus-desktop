# ==============================================================================
# Kamai Plus Desktop — Production .gitignore
# ==============================================================================

# Node dependencies
/node_modules
/.pnp
.pnp.js

# Next.js Build Outputs & Cache
/.next/
/out/

# Electron Packaging & Release Outputs
/dist/
/release/
/build/*
!/build/icon.ico

# TypeScript Build Cache & Generated Types
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage

# Environment & Local Secrets
.env
.env*.local
.env*
!.env.example
SESSION_HANDOVER.md
*.secret.md

# Logs & Debug Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firestore-debug.log*
hs_err_pid*.log

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Cloud / Hosting Metadata
.vercel
.firebase/

# Ad-hoc & Binary Files
*.apk
*.pem
*.pfx
*.key
*.xlsx
*.xls
repomix-output.*
